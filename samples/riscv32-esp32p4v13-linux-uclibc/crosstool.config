CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_PREFIX_DIR="${CT_TOP_DIR}/x-tools/${CT_TARGET}"
CT_ARCH_RISCV=y
# CT_ARCH_USE_MMU is not set
CT_ARCH_ARCH="rv32imac_zicsr_zifencei_xespv2p1"
CT_ARCH_ABI="ilp32"
CT_TARGET_VENDOR="esp32p4v13"
CT_TARGET_CFLAGS="-fPIC"
CT_KERNEL_LINUX=y
CT_LINUX_V_6_12=y
# CT_SHARED_LIBS is not set
CT_ARCH_BINFMT_FLAT=y
CT_BINUTILS_PATCH_BUNDLED_LOCAL=y
CT_LOCAL_PATCH_DIR="${CT_LIB_DIR}/samples/riscv32-esp32p4v13-linux-uclibc/patches"
CT_BINUTILS_SRC_DEVEL=y
CT_BINUTILS_DEVEL_URL="https://github.com/espressif/binutils-gdb.git"
CT_BINUTILS_DEVEL_REVISION="37a65a3e908599f625f94bd382ea06079a64a543"
# Single-version GAS/objdump: bare invocations must not dispatch to v3.
CT_BINUTILS_EXTRA_CONFIG_ARRAY="--enable-xespv2p1 --with-arch=rv32imac_zicsr_zifencei_xespv2p1"
CT_ELF2FLT_DEVEL_REVISION="f9584b84627e5f9ba20378f73b7edaa62090e08f"
CT_LIBC_UCLIBC_NG=y
# Required by Buildroot external-uClibc feature validation; not kernel networking.
CT_LIBC_UCLIBC_IPV6=y
CT_UCLIBC_NG_V_1_0_54=y
CT_THREADS_LT=y
CT_GCC_SRC_DEVEL=y
CT_GCC_DEVEL_URL="https://github.com/espressif/gcc.git"
CT_GCC_DEVEL_REVISION="0dbf584943ac179894690b389f3a37926bb4cd33"
# Buildroot supplies -fPIC -static -Wl,-elf2flt=-r on final program links.
# CT_CC_GCC_ENABLE_DEFAULT_PIE is not set
