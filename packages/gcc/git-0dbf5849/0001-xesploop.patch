 #define TARGET_CUSTOM_FUNCTION_DESCRIPTORS 1
 
+
+static bool
+riscv_can_use_doloop_p (const widest_int &, const widest_int &,
+                        unsigned int, bool)
+{
+  return TARGET_XESPLOOP;
+}
+
+static const char *
+riscv_invalid_within_doloop (const rtx_insn *insn)
+{
+  if (CALL_P (insn))
+    return "Function call in the loop.";
+
+  return NULL;
+}
+
+static rtx
+riscv_hwloop_pattern_reg (rtx_insn *insn)
+{
+  if (!JUMP_P (insn) || recog_memoized (insn) != CODE_FOR_esp_lp_end)
+    return NULL_RTX;
+  
+  rtx pat = PATTERN (insn);
+  if (GET_CODE (pat) != PARALLEL)
+    return NULL_RTX;
+  
+  rtx set1 = XVECEXP (pat, 0, 1);
+  if (GET_CODE (set1) == SET)
+    return SET_DEST (set1);
+  
+  return NULL_RTX;
+}
+
+static bool
+riscv_hwloops_opt_p (hwloop_info loop)
+{
+  if (loop->depth > 2)
+    return false;
+
+  if (loop->has_call || loop->has_asm)
+    return false;
+
+  if (!loop->incoming_dest || loop->incoming_dest != loop->head)
+    return false;
+
+  if (loop->iter_reg_used || loop->iter_reg_used_outside)
+    return false;
+
+  if (loop->length >= 4096)
+    return false;
+
+  rtx_insn *seq;
+  rtx_insn *insn;
+  edge entry_edge = NULL;
+  int i;
+  FOR_EACH_VEC_SAFE_ELT (loop->incoming, i, entry_edge)
+    if (entry_edge->flags & EDGE_FALLTHRU)
+      break;
+
+  if (entry_edge == NULL)
+    return false;
+
+  basic_block entry_bb = entry_edge->src;
+
+  rtx_insn *last_insn = prev_nonnote_nondebug_insn (loop->loop_end);
+  if (!last_insn)
+    return false;
+
+  rtx_code_label *end_label = gen_label_rtx ();
+  emit_label_before (end_label, last_insn);
+
+  start_sequence ();
+  insn = emit_insn (gen_esp_lp_setup (GEN_INT (loop->depth - 1), loop->iter_reg, end_label));
+  seq = get_insns ();
+  end_sequence ();
+
+  rtx_insn *entry_after = BB_END (entry_bb);
+  if (!single_succ_p (entry_bb) || vec_safe_length (loop->incoming) > 1 || !entry_after)
+    {
+      basic_block new_bb;
+      edge e;
+      edge_iterator ei;
+
+      emit_insn_before (seq, BB_HEAD (loop->head));
+      seq = emit_label_before (gen_label_rtx (), seq);
+      new_bb = create_basic_block (seq, insn, entry_bb);
+      FOR_EACH_EDGE (e, ei, loop->incoming)
+        {
+          if (!(e->flags & EDGE_FALLTHRU))
+            redirect_edge_and_branch_force (e, new_bb);
+          else
+            redirect_edge_succ (e, new_bb);
+        }
+      make_edge (new_bb, loop->head, 0);
+    }
+  else
+    {
+      while (DEBUG_INSN_P (entry_after) || NOTE_P (entry_after))
+        entry_after = PREV_INSN (entry_after);
+      emit_insn_after (seq, entry_after);
+    }
+  return true;
+}
+
+static void
+riscv_hwloops_fail (hwloop_info loop)
+{
+  rtx test;
+  rtx_insn *insn;
+  rtx add_insn;
+
+  if (GET_MODE (loop->iter_reg) == DImode)
+    add_insn = gen_adddi3 (loop->iter_reg, loop->iter_reg, constm1_rtx);
+  else
+    add_insn = gen_addsi3 (loop->iter_reg, loop->iter_reg, constm1_rtx);
+
+  emit_insn_before (add_insn, loop->loop_end);
+
+  test = gen_rtx_NE (VOIDmode, loop->iter_reg, const0_rtx);
+  rtx jump = gen_rtx_SET (pc_rtx,
+                          gen_rtx_IF_THEN_ELSE (VOIDmode, test,
+                                                gen_rtx_LABEL_REF (VOIDmode, loop->start_label),
+                                                pc_rtx));
+  insn = emit_jump_insn_before (jump, loop->loop_end);
+
+  JUMP_LABEL (insn) = loop->start_label;
+  LABEL_NUSES (loop->start_label)++;
+  delete_insn (loop->loop_end);
+}
+
+struct hw_doloop_hooks riscv_hw_doloop_hooks =
+{
+  riscv_hwloop_pattern_reg,
+  riscv_hwloops_opt_p,
+  riscv_hwloops_fail
+};
