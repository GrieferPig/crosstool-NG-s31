 /* Implement TARGET_MACHINE_DEPENDENT_REORG.  */
 
+extern struct hw_doloop_hooks riscv_hw_doloop_hooks;
+
 static void
 riscv_reorg (void)
 {
+  if (TARGET_XESPLOOP)
+    reorg_loops (false, &riscv_hw_doloop_hooks);
+
   /* Do nothing unless we have -msave-restore */
   if (TARGET_SAVE_RESTORE)
     riscv_remove_unneeded_save_restore_calls ();
@@ -14315,6 +14321,151 @@
