From: ESP32-S31 Linux contributors
Subject: [PATCH] riscv32: add gated XEspV string operations

Use the ESP32-S31 128-bit XEspV unit for the memory and string searches
which showed at least a 1.1x improvement on hardware.  Calls shorter than
64 bytes remain on scalar code so that vector setup and mask extraction do
not penalize small inputs.  strcmp similarly proves 64 equal non-NUL bytes
before entering its vector loop.

The aligned vector loads used for unbounded strings cannot cross a page
boundary.  This patch is specific to the Espressif riscv32 toolchain target,
whose configured ISA includes XEspV 2.2.
---
 src/string/memcpy.c               | 19 +++++++
 src/string/riscv32/memchr.S       | 91 +++++++++++++++++++++++++++
 src/string/riscv32/memcmp.S       | 61 +++++++++++++++++++
 src/string/riscv32/memrchr.S      | 73 ++++++++++++++++++++++
 src/string/riscv32/strcmp.S       | 84 ++++++++++++++++++++++++++
 src/string/riscv32/xespv_memops.S | 20 ++++++
 6 files changed, 348 insertions(+)
 create mode 100644 src/string/riscv32/memchr.S
 create mode 100644 src/string/riscv32/memcmp.S
 create mode 100644 src/string/riscv32/memrchr.S
 create mode 100644 src/string/riscv32/strcmp.S
 create mode 100644 src/string/riscv32/xespv_memops.S

diff --git a/src/string/memcpy.c b/src/string/memcpy.c
--- a/src/string/memcpy.c
+++ b/src/string/memcpy.c
@@ -3,10 +3,29 @@
 #include <endian.h>
 
+#if defined(__riscv) && __riscv_xlen == 32
+void __riscv32_xespv_memcpy64(void *, const void *, size_t);
+#endif
+
 void *memcpy(void *restrict dest, const void *restrict src, size_t n)
 {
 	unsigned char *d = dest;
 	const unsigned char *s = src;
 
+#if defined(__riscv) && __riscv_xlen == 32
+	/* The XEspV helper requires equal alignment and a whole 64-byte block. */
+	if (!(((uintptr_t)d ^ (uintptr_t)s) & 15)) {
+		size_t head = -(uintptr_t)d & 15;
+		if (n >= head + 64) {
+			for (; head; head--, n--) *d++ = *s++;
+			size_t vn = n & -(size_t)64;
+			__riscv32_xespv_memcpy64(d, s, vn);
+			d += vn;
+			s += vn;
+			n -= vn;
+		}
+	}
+#endif
+
 #ifdef __GNUC__
 
 #if __BYTE_ORDER == __LITTLE_ENDIAN
diff --git a/src/string/riscv32/memchr.S b/src/string/riscv32/memchr.S
new file mode 100644
--- /dev/null
+++ b/src/string/riscv32/memchr.S
@@ -0,0 +1,91 @@
+/* ESP32-S31 XEspV memchr.  Keep short inputs on musl's word-at-a-time path. */
+	.text
+	.align 2
+	.global memchr
+	.type memchr,@function
+memchr:
+	andi a1,a1,255
+	li t0,64
+	bgeu a2,t0,.Lvector_setup
+
+.Lscalar_align:
+	beqz a2,.Lnull
+	andi t0,a0,3
+	beqz t0,.Lscalar_word_setup
+	lbu t0,0(a0)
+	beq t0,a1,.Ldone
+	addi a0,a0,1
+	addi a2,a2,-1
+	j .Lscalar_align
+.Lscalar_word_setup:
+	li t0,0x01010101
+	mul t3,a1,t0
+.Lscalar_word:
+	li t0,4
+	bltu a2,t0,.Lscalar_tail
+	lw t0,0(a0)
+	xor t0,t0,t3
+	li t1,0x01010101
+	sub t2,t0,t1
+	not t0,t0
+	and t2,t2,t0
+	li t1,0x80808080
+	and t2,t2,t1
+	bnez t2,.Lscalar_tail
+	addi a0,a0,4
+	addi a2,a2,-4
+	j .Lscalar_word
+.Lscalar_tail:
+	beqz a2,.Lnull
+	lbu t0,0(a0)
+	beq t0,a1,.Ldone
+	addi a0,a0,1
+	addi a2,a2,-1
+	j .Lscalar_tail
+
+.Lvector_setup:
+	li t0,0x01010101
+	mul t1,a1,t0
+	addi sp,sp,-16
+	sw t1,0(sp)
+	sw t1,4(sp)
+	sw t1,8(sp)
+	sw t1,12(sp)
+	mv a3,sp
+	esp.vld.128.ip q1,a3,0
+	addi sp,sp,16
+.Lvector_align:
+	beqz a2,.Lnull
+	andi t0,a0,15
+	beqz t0,.Lvector
+	lbu t0,0(a0)
+	beq t0,a1,.Ldone
+	addi a0,a0,1
+	addi a2,a2,-1
+	j .Lvector_align
+.Lvector:
+	li t0,16
+	bltu a2,t0,.Lscalar_tail
+	addi sp,sp,-16
+	esp.vld.128.ip q0,a0,0
+	esp.vcmp.eq.u8 q2,q0,q1
+	mv a3,sp
+	esp.vst.128.ip q2,a3,0
+	fence rw,rw
+	lw t0,0(sp)
+	lw t1,4(sp)
+	or t0,t0,t1
+	lw t1,8(sp)
+	or t0,t0,t1
+	lw t1,12(sp)
+	or t0,t0,t1
+	addi sp,sp,16
+	bnez t0,.Lscalar_tail
+	addi a0,a0,16
+	addi a2,a2,-16
+	j .Lvector
+.Lnull:
+	li a0,0
+.Ldone:
+	ret
+	.size memchr,.-memchr
diff --git a/src/string/riscv32/memrchr.S b/src/string/riscv32/memrchr.S
new file mode 100644
--- /dev/null
+++ b/src/string/riscv32/memrchr.S
@@ -0,0 +1,73 @@
+/* ESP32-S31 XEspV reverse byte search with a scalar short-input path. */
+	.text
+	.align 2
+	.global __memrchr
+	.type __memrchr,@function
+__memrchr:
+	andi a1,a1,255
+	add a0,a0,a2
+	li t0,64
+	bgeu a2,t0,.Lr_vector_setup
+.Lr_scalar:
+	beqz a2,.Lr_null
+	addi a0,a0,-1
+	lbu t0,0(a0)
+	beq t0,a1,.Lr_done
+	addi a2,a2,-1
+	j .Lr_scalar
+
+.Lr_vector_setup:
+	li t0,0x01010101
+	mul t1,a1,t0
+	addi sp,sp,-16
+	sw t1,0(sp)
+	sw t1,4(sp)
+	sw t1,8(sp)
+	sw t1,12(sp)
+	mv a3,sp
+	esp.vld.128.ip q1,a3,0
+	addi sp,sp,16
+.Lr_align:
+	beqz a2,.Lr_null
+	andi t0,a0,15
+	beqz t0,.Lr_vector
+	addi a0,a0,-1
+	lbu t0,0(a0)
+	beq t0,a1,.Lr_done
+	addi a2,a2,-1
+	j .Lr_align
+.Lr_vector:
+	li t0,16
+	bltu a2,t0,.Lr_scalar
+	addi a0,a0,-16
+	addi sp,sp,-16
+	esp.vld.128.ip q0,a0,0
+	esp.vcmp.eq.u8 q2,q0,q1
+	mv a3,sp
+	esp.vst.128.ip q2,a3,0
+	fence rw,rw
+	lw t0,0(sp)
+	lw t1,4(sp)
+	or t0,t0,t1
+	lw t1,8(sp)
+	or t0,t0,t1
+	lw t1,12(sp)
+	or t0,t0,t1
+	addi sp,sp,16
+	bnez t0,.Lr_hit
+	addi a2,a2,-16
+	j .Lr_vector
+.Lr_hit:
+	addi a0,a0,16
+.Lr_hit_loop:
+	addi a0,a0,-1
+	lbu t0,0(a0)
+	beq t0,a1,.Lr_done
+	j .Lr_hit_loop
+.Lr_null:
+	li a0,0
+.Lr_done:
+	ret
+	.size __memrchr,.-__memrchr
+	.weak memrchr
+	.set memrchr,__memrchr
diff --git a/src/string/riscv32/memcmp.S b/src/string/riscv32/memcmp.S
new file mode 100644
--- /dev/null
+++ b/src/string/riscv32/memcmp.S
@@ -0,0 +1,61 @@
+/* ESP32-S31 XEspV memcmp.  Vectorize only ranges of at least 64 bytes. */
+	.text
+	.align 2
+	.global memcmp
+	.type memcmp,@function
+memcmp:
+	li t0,64
+	bltu a2,t0,.Lc_byte
+	xor t0,a0,a1
+	andi t0,t0,15
+	bnez t0,.Lc_byte
+.Lc_align:
+	andi t0,a0,15
+	beqz t0,.Lc_vector
+	lbu t0,0(a0)
+	lbu t1,0(a1)
+	bne t0,t1,.Lc_diff
+	addi a0,a0,1
+	addi a1,a1,1
+	addi a2,a2,-1
+	j .Lc_align
+.Lc_vector:
+	li t0,16
+	bltu a2,t0,.Lc_byte
+	addi sp,sp,-16
+	esp.vld.128.ip q0,a0,0
+	esp.vld.128.ip q1,a1,0
+	esp.vcmp.eq.u8 q2,q0,q1
+	mv a3,sp
+	esp.vst.128.ip q2,a3,0
+	fence rw,rw
+	lw t0,0(sp)
+	lw t1,4(sp)
+	and t0,t0,t1
+	lw t1,8(sp)
+	and t0,t0,t1
+	lw t1,12(sp)
+	and t0,t0,t1
+	addi sp,sp,16
+	li t1,-1
+	bne t0,t1,.Lc_byte
+	addi a0,a0,16
+	addi a1,a1,16
+	addi a2,a2,-16
+	j .Lc_vector
+.Lc_byte:
+	beqz a2,.Lc_equal
+	lbu t0,0(a0)
+	lbu t1,0(a1)
+	bne t0,t1,.Lc_diff
+	addi a0,a0,1
+	addi a1,a1,1
+	addi a2,a2,-1
+	j .Lc_byte
+.Lc_diff:
+	sub a0,t0,t1
+	ret
+.Lc_equal:
+	li a0,0
+	ret
+	.size memcmp,.-memcmp
diff --git a/src/string/riscv32/strcmp.S b/src/string/riscv32/strcmp.S
new file mode 100644
--- /dev/null
+++ b/src/string/riscv32/strcmp.S
@@ -0,0 +1,84 @@
+/* ESP32-S31 XEspV strcmp.  Probe 64 bytes before paying vector overhead. */
+	.text
+	.align 2
+	.global strcmp
+	.type strcmp,@function
+strcmp:
+	xor t0,a0,a1
+	andi t0,t0,15
+	bnez t0,.Ls_byte
+	li t5,64
+.Ls_probe:
+	lbu t0,0(a0)
+	lbu t1,0(a1)
+	bne t0,t1,.Ls_diff
+	beqz t0,.Ls_equal
+	addi a0,a0,1
+	addi a1,a1,1
+	addi t5,t5,-1
+	bnez t5,.Ls_probe
+.Ls_align:
+	andi t0,a0,15
+	beqz t0,.Ls_vector_setup
+	lbu t0,0(a0)
+	lbu t1,0(a1)
+	bne t0,t1,.Ls_diff
+	beqz t0,.Ls_equal
+	addi a0,a0,1
+	addi a1,a1,1
+	j .Ls_align
+.Ls_vector_setup:
+	addi sp,sp,-16
+	sw zero,0(sp)
+	sw zero,4(sp)
+	sw zero,8(sp)
+	sw zero,12(sp)
+	mv a3,sp
+	esp.vld.128.ip q3,a3,0
+	addi sp,sp,16
+.Ls_vector:
+	addi sp,sp,-32
+	esp.vld.128.ip q0,a0,0
+	esp.vld.128.ip q1,a1,0
+	esp.vcmp.eq.u8 q2,q0,q1
+	esp.vcmp.eq.u8 q4,q0,q3
+	mv a3,sp
+	esp.vst.128.ip q4,a3,16
+	esp.vst.128.ip q2,a3,0
+	fence rw,rw
+	lw t0,0(sp)
+	lw t1,4(sp)
+	or t0,t0,t1
+	lw t1,8(sp)
+	or t0,t0,t1
+	lw t1,12(sp)
+	or t0,t0,t1
+	lw t2,16(sp)
+	lw t1,20(sp)
+	and t2,t2,t1
+	lw t1,24(sp)
+	and t2,t2,t1
+	lw t1,28(sp)
+	and t2,t2,t1
+	addi sp,sp,32
+	li t1,-1
+	bne t2,t1,.Ls_byte
+	bnez t0,.Ls_byte
+	addi a0,a0,16
+	addi a1,a1,16
+	j .Ls_vector
+.Ls_byte:
+	lbu t0,0(a0)
+	lbu t1,0(a1)
+	bne t0,t1,.Ls_diff
+	beqz t0,.Ls_equal
+	addi a0,a0,1
+	addi a1,a1,1
+	j .Ls_byte
+.Ls_diff:
+	sub a0,t0,t1
+	ret
+.Ls_equal:
+	li a0,0
+	ret
+	.size strcmp,.-strcmp
diff --git a/src/string/riscv32/xespv_memops.S b/src/string/riscv32/xespv_memops.S
new file mode 100644
--- /dev/null
+++ b/src/string/riscv32/xespv_memops.S
@@ -0,0 +1,20 @@
+/* ESP32-S31 XEspV memcpy kernel. Callers guarantee 16-byte alignment. */
+	.text
+	.align 2
+	.hidden __riscv32_xespv_memcpy64
+	.global __riscv32_xespv_memcpy64
+	.type __riscv32_xespv_memcpy64,@function
+__riscv32_xespv_memcpy64:
+.Lx_copy:
+	esp.vld.128.ip q0,a1,16
+	esp.vld.128.ip q1,a1,16
+	esp.vld.128.ip q2,a1,16
+	esp.vld.128.ip q3,a1,16
+	esp.vst.128.ip q0,a0,16
+	esp.vst.128.ip q1,a0,16
+	esp.vst.128.ip q2,a0,16
+	esp.vst.128.ip q3,a0,16
+	addi a2,a2,-64
+	bnez a2,.Lx_copy
+	ret
+	.size __riscv32_xespv_memcpy64,.-__riscv32_xespv_memcpy64
-- 
